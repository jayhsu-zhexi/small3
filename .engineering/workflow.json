  "designs": [
    {
      "created_revision": 19,
      "id": "DES-001",
      "reuse": [
        "既有 one–ten WAV",
        "MultiplyAudio 答對答錯語音",
        "CompletionParty 的一般與全綠三連跳"
      ],
      "risks": [
        "聽音與拼字不得先顯示答案",
        "重複字母的可用數量",
        "答錯後續玩不能變全綠",
        "取消或離頁後舊音訊不得繼續",
        "舊首頁設定需相容"
      ],
      "solution": "新增 number-bakery.html、CSS、引擎、音訊及 UI；所有答案格為按鈕。純引擎管理十題牌組、錯誤旗標與可驗證快照；UI 只顯示當下可見資訊。沿用 vocabulary-audio 與 MultiplyAudio/CompletionParty。以必要的新遊戲缺項辨識舊首頁設定，保持原排序、可見性與 revision，讀取時補入新卡。",
      "status": "converged",
      "title": "獨立靜態頁與共用素材",
      "tradeoffs": [
        "不使用麥克風，跟讀是自主練習而非發音評分",
        "本機保存，不新增帳號或伺服器進度"
      ],
      "updated_revision": 27,
      "verification": [
        "引擎與音訊測試",
        "既有首頁管理測試",
        "實際手機與平板版面及兩類完成測試",
        "精確部署驗證"
      ]
    }
  ],
