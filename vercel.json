{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "node --version",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/pinball",
      "destination": "/pinball.html"
    },
    {
      "source": "/pinball/",
      "destination": "/pinball.html"
    },
    {
      "source": "/kart",
      "destination": "/kart.html"
    },
    {
      "source": "/kart/",
      "destination": "/kart.html"
    },
    {
      "source": "/survival",
      "destination": "/survival.html"
    },
    {
      "source": "/survival/",
      "destination": "/survival.html"
    },
    {
      "source": "/vault",
      "destination": "/vault.html"
    },
    {
      "source": "/vault/",
      "destination": "/vault.html"
    },
    {
      "source": "/memory",
      "destination": "/memory.html"
    },
    {
      "source": "/memory/",
      "destination": "/memory.html"
    },
    {
      "source": "/crossing",
      "destination": "/crossing.html"
    },
    {
      "source": "/crossing/",
      "destination": "/crossing.html"
    },
    {
      "source": "/parcels",
      "destination": "/parcels.html"
    },
    {
      "source": "/parcels/",
      "destination": "/parcels.html"
    },
    {
      "source": "/detective",
      "destination": "/detective.html"
    },
    {
      "source": "/detective/",
      "destination": "/detective.html"
    },
    {
      "source": "/board",
      "destination": "/board.html"
    },
    {
      "source": "/board/",
      "destination": "/board.html"
    },
    {
      "source": "/((?!assets/|(?:board|detective|parcels|crossing|memory|pinball|vault|survival|kart)(?:/|$|\\.html$)).*)",
      "destination": "/index.html"
    }
  ]
}
