{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "node --version",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/detective",
      "destination": "/detective.html"
    },
    {
      "source": "/detective/",
      "destination": "/detective.html"
    },
    {
      "source": "/board",
      "destination": "/board.html"
    },
    {
      "source": "/board/",
      "destination": "/board.html"
    },
    {
      "source": "/((?!assets/|board(?:/|$)|board.html$|detective(?:/|$)|detective.html$).*)",
      "destination": "/index.html"
    }
  ]
}
